# Copy this file to .env and adjust it:  cp .env.example .env
# The server reads .env at startup. Variables already set in the shell win.

# Port of the web server (default 8080).
PORT=8080

# --- LLM backend --------------------------------------------------------
# Leave LLM_BASE_URL empty (or delete it) to run in MOCK MODE:
# /api/suggest and /api/variations then return deterministic canned answers
# without any network request or API key.
#
# Any OpenAI-compatible API works. Examples:
#   Ollama (local, free, no key):  LLM_BASE_URL=http://localhost:11434   LLM_MODEL=llama3.2
#   OpenAI:                        LLM_BASE_URL=https://api.openai.com   LLM_MODEL=gpt-4o-mini
#   Groq (free tier):              LLM_BASE_URL=https://api.groq.com/openai  LLM_MODEL=llama-3.1-8b-instant
LLM_BASE_URL=
LLM_MODEL=

# API key, only for hosted services (Ollama does not need one).
# Never commit your real key: .env is in .gitignore.
LLM_API_KEY=
